<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 清除机器级残留配置（旧 VS 卸载后遗留的本地源已不存在，会导致 NU1301），只保留 nuget.org -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
