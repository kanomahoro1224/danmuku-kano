<Window
    x:Class="damuku_kano.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:damuku_kano.Models"
    xmlns:services="using:damuku_kano.Services"
    Title="{x:Bind services:LocalizationService.Instance.AppTitle, Mode=OneWay}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="NavView" SelectionChanged="NavView_SelectionChanged" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False">
        <NavigationView.MenuItems>
            <NavigationViewItem Tag="Style" Content="{x:Bind services:LocalizationService.Instance.NavStyle, Mode=OneWay}" Icon="Edit" />
            <NavigationViewItem Tag="History" Content="{x:Bind services:LocalizationService.Instance.NavHistory, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE815;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Tag="Settings" Content="{x:Bind services:LocalizationService.Instance.TextSystemSettings, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="About" Content="{x:Bind services:LocalizationService.Instance.NavAbout, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        
        <Grid Padding="24">
            
            <!-- Style Pane -->
            <ScrollViewer x:Name="StylePane" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,16,24">
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.NavStyle, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24"/>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextFontSize, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="FontSizeSlider" Minimum="50" Maximum="300" Value="100" Width="300" HorizontalAlignment="Left"/>
                    
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextSpeed, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="20" Value="6" Width="300" HorizontalAlignment="Left"/>
                    
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextOpacity, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" Width="300" HorizontalAlignment="Left"/>
                    
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextDisplayArea, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="DisplayAreaSlider" Minimum="10" Maximum="100" Value="100" Width="300" HorizontalAlignment="Left"/>

                    <NumberBox x:Name="MaxNotificationLengthBox"
                               Header="{x:Bind services:LocalizationService.Instance.TextMaxNotificationLength, Mode=OneWay}"
                               Minimum="1" Maximum="999" Value="30" SpinButtonPlacementMode="Compact"
                               Width="160" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextDensity, Mode=OneWay}" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <RadioButton x:Name="DensityNormal" Content="{x:Bind services:LocalizationService.Instance.TextDensityNormal, Mode=OneWay}" IsChecked="True" GroupName="Density"/>
                        <RadioButton x:Name="DensityMore" Content="{x:Bind services:LocalizationService.Instance.TextDensityMore, Mode=OneWay}" GroupName="Density"/>
                        <RadioButton x:Name="DensityOverlap" Content="{x:Bind services:LocalizationService.Instance.TextDensityOverlap, Mode=OneWay}" GroupName="Density"/>
                    </StackPanel>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextDisplayScreen, Mode=OneWay}" Margin="0,12,0,4"/>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton x:Name="ScreenPrimary" Content="{x:Bind services:LocalizationService.Instance.TextScreenPrimary, Mode=OneWay}" IsChecked="True" GroupName="Screen"/>
                            <RadioButton x:Name="ScreenAll" Content="{x:Bind services:LocalizationService.Instance.TextScreenAll, Mode=OneWay}" GroupName="Screen"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton x:Name="ScreenSpan" Content="{x:Bind services:LocalizationService.Instance.TextScreenSpan, Mode=OneWay}" GroupName="Screen"/>
                            <RadioButton x:Name="ScreenMouse" Content="{x:Bind services:LocalizationService.Instance.TextScreenMouse, Mode=OneWay}" GroupName="Screen"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextFontAndColor, Mode=OneWay}" Margin="0,12,0,4"/>
                    <StackPanel Spacing="12" Margin="0,0,0,12">
                        <ComboBox x:Name="FontFamilyCombo" Width="260" SelectedIndex="0" MaxDropDownHeight="420"/>
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <DropDownButton Content="{x:Bind services:LocalizationService.Instance.TextDanmakuColorConfig, Mode=OneWay}" Width="150">
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="DanmakuColor" Color="White" 
                                                     IsColorSpectrumVisible="True" 
                                                     IsColorPreviewVisible="True" 
                                                     IsColorSliderVisible="True" 
                                                     IsAlphaEnabled="False" 
                                                     IsHexInputVisible="True" 
                                                     IsColorChannelTextInputVisible="True" 
                                                     IsMoreButtonVisible="False" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Content="{x:Bind services:LocalizationService.Instance.TextBorderColorConfig, Mode=OneWay}" Width="150">
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="BorderColor" Color="Black" 
                                                     IsColorSpectrumVisible="True" 
                                                     IsColorPreviewVisible="True" 
                                                     IsColorSliderVisible="True" 
                                                     IsAlphaEnabled="False" 
                                                     IsHexInputVisible="True" 
                                                     IsColorChannelTextInputVisible="True" 
                                                     IsMoreButtonVisible="False" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <DropDownButton Content="{x:Bind services:LocalizationService.Instance.TextShadowColorConfig, Mode=OneWay}" Width="150">
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="ShadowColor" Color="Black" 
                                                     IsColorSpectrumVisible="True" 
                                                     IsColorPreviewVisible="True" 
                                                     IsColorSliderVisible="True" 
                                                     IsAlphaEnabled="False" 
                                                     IsHexInputVisible="True" 
                                                     IsColorChannelTextInputVisible="True" 
                                                     IsMoreButtonVisible="False" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </StackPanel>

                    <ToggleSwitch x:Name="BoldToggle" Header="{x:Bind services:LocalizationService.Instance.TextBold, Mode=OneWay}" IsOn="True" Margin="0,12,0,0"/>
                    <ToggleSwitch x:Name="BorderToggle" Header="{x:Bind services:LocalizationService.Instance.TextBorder, Mode=OneWay}" IsOn="False" Margin="0,12,0,0"/>
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextBorderThickness, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="8" StepFrequency="0.5" Value="2" Width="300" HorizontalAlignment="Left"/>
                    <ToggleSwitch x:Name="ShadowToggle" Header="{x:Bind services:LocalizationService.Instance.TextShadow, Mode=OneWay}" IsOn="True" Margin="0,12,0,0"/>
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextShadowBlur, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="24" StepFrequency="1" Value="4" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextShadowDepth, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="16" StepFrequency="1" Value="2" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextShadowOpacity, Mode=OneWay}" Margin="0,12,0,4"/>
                    <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="100" StepFrequency="5" Value="100" Width="300" HorizontalAlignment="Left"/>

                    <Button Content="{x:Bind services:LocalizationService.Instance.TextTestDanmaku, Mode=OneWay}" Margin="0,24,0,0" Click="BtnTest_Click" Style="{ThemeResource AccentButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- System Settings Pane -->
            <ScrollViewer x:Name="SystemSettingsPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="0,0,16,24">
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextSystemSettings, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24"/>
                    
                    <ComboBox x:Name="LanguageCombo" Header="{x:Bind services:LocalizationService.Instance.TextLanguage, Mode=OneWay}" SelectedIndex="0" Width="200">
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageHans, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageHant, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageEn, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageJa, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageKo, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageFr, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageDe, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageEs, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguagePtBr, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageRu, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageIt, Mode=OneWay}"/>
                        <ComboBoxItem Content="{x:Bind services:LocalizationService.Instance.TextLanguageTr, Mode=OneWay}"/>
                    </ComboBox>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextCloseAction, Mode=OneWay}" Margin="0,24,0,8"/>
                    <StackPanel Spacing="8">
                        <RadioButton x:Name="CloseActionMinimize" Content="{x:Bind services:LocalizationService.Instance.TextMinimizeToTray, Mode=OneWay}" IsChecked="True" GroupName="CloseAction"/>
                        <RadioButton x:Name="CloseActionExit" Content="{x:Bind services:LocalizationService.Instance.TextExitApp, Mode=OneWay}" GroupName="CloseAction"/>
                        <CheckBox x:Name="CloseActionPrompt" Content="{x:Bind services:LocalizationService.Instance.TextClosePrompt, Mode=OneWay}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="AutoStartToggle" Header="{x:Bind services:LocalizationService.Instance.TextAutoStart, Mode=OneWay}" IsOn="False" Margin="0,24,0,0"/>

                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextPerformanceMode, Mode=OneWay}" Margin="0,24,0,4"/>
                    <TextBlock Text="{x:Bind services:LocalizationService.Instance.TextPerformanceModeDesc, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Spacing="8">
                        <RadioButton x:Name="PerfFluent" Content="{x:Bind services:LocalizationService.Instance.TextPerfFluent, Mode=OneWay}" IsChecked="True" GroupName="PerfMode"/>
                        <RadioButton x:Name="PerfBalanced" Content="{x:Bind services:LocalizationService.Instance.TextPerfBalanced, Mode=OneWay}" GroupName="PerfMode"/>
                        <RadioButton x:Name="PerfGame" Content="{x:Bind services:LocalizationService.Instance.TextPerfGame, Mode=OneWay}" GroupName="PerfMode"/>
                        <RadioButton x:Name="PerfEco" Content="{x:Bind services:LocalizationService.Instance.TextPerfEco, Mode=OneWay}" GroupName="PerfMode"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- About Pane -->
            <ScrollViewer x:Name="AboutPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="480">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28" Padding="24">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22">
                            <Image Source="ms-appx:///B_1720288456383.png" Width="112" Height="112" Stretch="Uniform"/>
                            <TextBlock Text="Kano" FontSize="48" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <TextBlock Text="{x:Bind services:LocalizationService.Instance.AboutProductName, Mode=OneWay}" FontSize="22" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind AboutVersionText, Mode=OneWay}" FontSize="20" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,24,0,0">
                                <TextBlock Text="{x:Bind services:LocalizationService.Instance.AboutMadeByPrefix, Mode=OneWay}" FontSize="20"/>
                                <TextBlock Text="❤" FontSize="20" Foreground="#E83B3B"/>
                                <TextBlock Text="{x:Bind services:LocalizationService.Instance.AboutMadeBySuffix, Mode=OneWay}" FontSize="20"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            
            <!-- History Pane -->
            <Grid x:Name="HistoryPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind services:LocalizationService.Instance.NavHistory, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,24"/>
                
                <ListView Grid.Row="1" x:Name="HistoryList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationItem">
                            <!-- Mimicking the Windows 11 Notification Toast Card Style -->
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="0,4,0,4" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                               <Grid HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <PersonPicture Width="20" Height="20" ProfilePicture="{x:Bind AppIconSource, Mode=OneWay}" DisplayName="{x:Bind AppName}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                                    <TextBlock Text="{x:Bind AppName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"/>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="28,8,0,0">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Message}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
